    { "code": "0x01", "id": 1,  "cn": "法", "sym": "?fn",   "ascii": "law",    "domain": "architecture", "preempt_cn": "立法", "implemented_in_core": true,  "desc": "Layer-1 Pure validation guard (read-only; returns 真 or raises 立断)" },
