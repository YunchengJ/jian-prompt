{
  "schema_version": "0.9.0-DualMode",
  "language_name": "简 (Jian-Lang)",
  "encoding_bits": 7,
  "total_slots": 128,
  "lexical_conventions": {
    "line_comment": "//",
    "token_separator": "whitespace or bracket boundaries ([ ], 【 】, 式[ ], @{ }, $[ ])",
    "string_literal": "double-quoted UTF-8 string with backslash escapes (\\\" \\\\ \\n)"
  },
  "preemption_bit_rule": {
    "bit_index": 6,
    "hex_mask": "0x40",
    "chinese_prefix": "立",
    "symbolic_prefix": "!!",
    "description": "Setting Bit 6 (+64 / 0x40) turns any base opcode (0x00..0x3F) into a highest-priority queue-preempting instruction (0x40..0x7F). On 项/行 (立项/立行), it also enables pessimistic exclusive register locking."
  },
  "slot_delimiters": {
    "data_state_slot": { "cn": ["[", "]"], "ascii": ["[", "]"], "role": "Strictly data variable, typed register, literal, or Prefix Key-Chain state ONLY (never executable statements)" },
    "module_code_slot": { "cn": ["【", "】"], "ascii": ["@{", "}"], "role": "Strictly callable 法/项/纲 code closures and branch statement blocks (则 【...】, 通 去 【...】)" },
    "formula_sandbox_slot": {
      "cn": ["式[", "]"],
      "ascii": ["$[", "]"],
      "role": "Dual-mode algebraic & wavefront expression sandbox",
      "calling_convention": {
        "llm_recommended": "建议 LLM 不使用括号而使用嵌套运算层级汉语运算法（如：先先减 / 后幂 / 后后增 / 后后后商），消除远距离括号配对并对齐并行求值波次",
        "human_recommended": "建议人工使用原始的标准阿拉伯线性表达式（如：((x甲 - 乙) ^ 2 + (x乙 - 乙) ^ 2) / (2 * (戊 ^ 2))），防人工转译笔误",
        "wavefront_tie_breaking_rule": "同波次算子仅当左右操作数区间互不重叠时可并行归约；若相邻同波次算子共享操作数（如 a 先减 b 先减 c），强制按从左到右结合求值 ((a - b) - c)。"
      }
    }
  },
  "base_opcodes_64": [
