    { "code": "0x03", "id": 3,  "cn": "纲", "sym": "#proj", "ascii": "proj",   "domain": "architecture", "preempt_cn": "立纲", "implemented_in_core": true,  "desc": "Layer-3 Top-level schedulable project/coroutine handle" },
    { "code": "0x04", "id": 4,  "cn": "事", "sym": "@evt",  "ascii": "evt",    "domain": "architecture", "preempt_cn": "立事", "implemented_in_core": true,  "desc": "Transaction/event pipeline unit" },
