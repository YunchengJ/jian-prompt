    { "code": "0x0C", "id": 12, "cn": "判", "sym": "bool",  "ascii": "bool",   "domain": "type",         "preempt_cn": "立判", "implemented_in_core": true,  "desc": "Boolean type & inline predicate filter" },

    { "code": "0x0D", "id": 13, "cn": "去", "sym": "->",    "ascii": "to",     "domain": "flow",         "preempt_cn": "立去", "implemented_in_core": true,  "desc": "Left-to-right forward pipeline operator (also →, |>)" },
    { "code": "0x0E", "id": 14, "cn": "返", "sym": "<-",    "ascii": "ret",    "domain": "flow",         "preempt_cn": "立返", "implemented_in_core": true,  "desc": "Right-to-left value bind (←, =), or directed non-local jump to 【纲/目/法】" },
